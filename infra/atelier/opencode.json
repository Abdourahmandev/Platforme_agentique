{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (DeepSeek / Gemini)",
      "options": {
        "baseURL": "http://litellm:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "asia-pro": { "name": "DeepSeek V4 Pro" },
        "asia-rapide": { "name": "DeepSeek Flash" },
        "gemini-3.8-flash": { "name": "Gemini 3.8 Flash" },
        "gemini-3.1-pro-preview": { "name": "Gemini 3.1 Pro" }
      }
    }
  }
}
