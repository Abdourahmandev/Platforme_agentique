[Unit]
Description=Asia platform encrypted backup with restore check
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=rass
Environment=LOCALAPPDATA=/home/rass/.local/share
Environment=ASIA_BACKUP_REMOTE=gdrive:Openclawbackup-serveur
Environment=RCLONE_LOG_LEVEL=ERROR
ExecStart=/home/rass/Platforme_agentique/ops/run-docker-backup.sh
TimeoutStartSec=30min
Nice=10
