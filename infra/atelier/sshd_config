# Key-only access for the single `node` user used by Paperclip runs.
Port 2222
HostKey /etc/ssh/host/ssh_host_ed25519_key
AuthorizedKeysFile /etc/ssh/authorized/authorized_keys
StrictModes no
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AllowUsers node
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PrintMotd no
UsePAM no
Subsystem sftp internal-sftp
# Paperclip passes per-run environment through the remote command itself.
AcceptEnv LANG LC_*
